      "group": "DMX-Grove",
      "type": "dmx-grove",
      "label": "Grove DMX512",
      "description": "Grove DMX512 shield (SP3485 line driver): turns the board UART into a DMX512 output on a 3-pin XLR socket.",
      "version": "2026.8.1",
      "author": "Frank Sauret",
      "reference": "https://wiki.seeedstudio.com/Grove-DMX512/",
      "kind": "passive",
      "category": "Misc",
      "l10n": {
        "fr": {
          "label": "Grove DMX512",
          "description": "Carte Grove DMX512 (émetteur de ligne SP3485) : transforme l'UART de la carte en sortie DMX512 sur une embase XLR 3 points."
        }
      }
    },
    {
      "group": "Spot",
      "type": "spot",
      "label": "DMX PAR 38 spotlight",
      "description": "PAR 38 LED spotlight driven over DMX512 (Contest): the LED array takes the colour sent on its channels.",
      "version": "2026.8.1",
      "author": "Frank Sauret",
      "reference": "https://www.contest-lighting.com/",
      "kind": "passive",
      "category": "Systems",
      "params": [
        {
          "name": "address",
          "label": "DMX address (channels: red, green, blue)",
          "value": 1
        }
      ],
      "l10n": {
        "fr": {
          "label": "Projecteur DMX PAR 38",
          "description": "Projecteur à LED PAR 38 piloté en DMX512 (Contest) : le bloc de LED prend la couleur envoyée sur ses canaux.",
          "params": {
            "address": "Adresse DMX (canaux : rouge, vert, bleu)"
          }
        }
      }
    },
    {
      "group": "BarriereIR",
      "type": "ir-barrier",
      "label": "Through-beam IR barrier",
      "description": "Through-beam infrared barrier (emitter + receiver): while the beam reaches the receiver its output transistor conducts and OUT stays low; an object cutting the beam releases it and the pull-up brings OUT high. Open-collector output: a pull-up is required.",
