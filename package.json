{
  "name": "kablix",
  "displayName": "Kablix",
  "version": "2026.9.5",
  "buildNumber": 137,
  "description": "%kablix.description%",
  "publisher": "electropol-fr",
  "author": {
    "name": "electropol.fr",
    "url": "https://electropol.fr"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/FrankSAURET/kablix"
  },
  "bugs": {
    "url": "https://github.com/FrankSAURET/kablix/issues"
  },
  "homepage": "https://github.com/FrankSAURET/kablix#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "arduino",
    "raspberry pi pico",
    "microcontroller",
    "simulator",
    "simulation",
    "rp2040",
    "rp2350",
    "avr",
    "offline"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "kablix.openSimulator",
        "title": "%kablix.cmd.openSimulator%",
        "category": "Kablix"
      },
      {
        "command": "kablix.compileAndRun",
        "title": "%kablix.cmd.compileAndRun%",
        "category": "Kablix"
      },
      {
        "command": "kablix.loadWorkspaceArtifact",
        "title": "%kablix.cmd.loadWorkspaceArtifact%",
        "category": "Kablix"
      },
      {
        "command": "kablix.saveProject",
        "title": "%kablix.cmd.saveProject%",
        "category": "Kablix"
      },
      {
        "command": "kablix.saveProjectSmart",
        "title": "%kablix.cmd.saveProjectSmart%",
        "category": "Kablix"
      },
      {
        "command": "kablix.openProject",
        "title": "%kablix.cmd.openProject%",
        "category": "Kablix"
      },
      {
        "command": "kablix.exportWokwiDiagram",
        "title": "%kablix.cmd.exportWokwiDiagram%",
        "category": "Kablix"
      },
      {
        "command": "kablix.importWokwiDiagram",
        "title": "%kablix.cmd.importWokwiDiagram%",
        "category": "Kablix"
      },
      {
        "command": "kablix.exportPartsCsv",
        "title": "%kablix.cmd.exportPartsCsv%",
        "category": "Kablix"
      },
      {
        "command": "kablix.checkLibraryUpdates",
        "title": "%kablix.cmd.checkLibraryUpdates%",
        "category": "Kablix"
      },
      {
        "command": "kablix.upgradePicoFirmware",
        "title": "%kablix.cmd.upgradePicoFirmware%",
        "category": "Kablix"
      },
      {
        "command": "kablix.openHelp",
        "title": "%kablix.cmd.openHelp%",
        "category": "Kablix"
      },
      {
        "command": "kablix.saveDefaultLayout",
        "title": "%kablix.cmd.saveDefaultLayout%",
        "category": "Kablix"
      },
      {
        "command": "kablix.openSettings",
        "title": "%kablix.cmd.openSettings%",
        "category": "Kablix"
      },
      {
        "command": "kablix.rearrangeLayout",
        "title": "%kablix.cmd.rearrangeLayout%",
        "category": "Kablix"
      },
      {
        "command": "kablix.associateProjix",
        "title": "%kablix.cmd.associateProjix%",
        "category": "Kablix"
      },
      {
        "command": "kablix.fixIntelliSense",
        "title": "%kablix.cmd.fixIntelliSense%",
        "category": "Kablix"
      },
      {
        "command": "kablix.recommendedExtensions",
        "title": "%kablix.cmd.recommendedExtensions%",
        "category": "Kablix"
      },
      {
        "command": "kablix.redetectArduinoCli",
        "title": "%kablix.cmd.redetectArduinoCli%",
        "category": "Kablix"
      },
      {
        "command": "kablix.chooseSvgEditor",
        "title": "%kablix.cmd.chooseSvgEditor%",
        "category": "Kablix"
      },
      {
        "command": "kablix.openComponentsFolder",
        "title": "%kablix.cmd.openComponentsFolder%",
        "category": "Kablix"
      },
      {
        "command": "kablix.openComponentManager",
        "title": "%kablix.cmd.openComponentManager%",
        "category": "Kablix"
      },
      {
        "command": "kablix.uploadToPico",
        "title": "%kablix.cmd.uploadToPico%",
        "category": "Kablix",
        "icon": "media/upload.svg"
      },
      {
        "command": "kablix.uploadToPicoOffline",
        "title": "%kablix.cmd.uploadToPicoOffline%",
        "category": "Kablix",
        "icon": "media/upload-inactive.svg"
      }
    ],
    "keybindings": [
      {
        "command": "kablix.saveProjectSmart",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeCustomEditorId == 'kablix.projix'"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "kablix.uploadToPico",
          "group": "navigation@-3",
          "when": "resourceLangId == python && kablix.picoConnected"
        },
        {
          "command": "kablix.uploadToPicoOffline",
          "group": "navigation@-3",
          "when": "resourceLangId == python && !kablix.picoConnected"
        }
      ],
      "commandPalette": [
        {
          "command": "kablix.uploadToPicoOffline",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kablix",
          "title": "Kablix",
          "icon": "media/activity-icon.png"
        }
      ]
    },
    "views": {
      "kablix": [
        {
          "id": "kablix.home",
          "name": "%kablix.view.home%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "kablix.home",
        "contents": "%kablix.welcome%"
      }
    ],
    "customEditors": [
      {
        "viewType": "kablix.projix",
        "displayName": "%kablix.editor.projix%",
        "selector": [
          {
            "filenamePattern": "*.projix"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Kablix",
      "properties": {
        "kablix.micropythonUf2": {
          "type": "string",
          "default": "",
          "description": "%kablix.config.micropythonUf2%"
        },
        "kablix.checkUpdatesOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "%kablix.config.checkUpdatesOnStartup%"
        },
        "kablix.simulationWorker": {
          "type": "boolean",
          "default": true,
          "description": "%kablix.config.simulationWorker%"
        },
        "kablix.checkFirmwareUpdatesOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "%kablix.config.checkFirmwareUpdatesOnStartup%"
        },
        "kablix.restoreLastProjectOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "%kablix.config.restoreLastProjectOnStartup%"
        },
        "kablix.arduinoCliPath": {
          "type": "string",
          "default": "",
          "description": "%kablix.config.arduinoCliPath%"
        },
        "kablix.toolchainPath": {
          "type": "string",
          "default": "",
          "description": "%kablix.config.toolchainPath%"
        },
        "kablix.showLoadBinaryButton": {
          "type": "boolean",
          "default": false,
          "description": "%kablix.config.showLoadBinaryButton%"
        },
        "kablix.showResetPartsButton": {
          "type": "boolean",
          "default": false,
          "description": "%kablix.config.showResetPartsButton%"
        },
        "kablix.showClearDiagramButton": {
          "type": "boolean",
          "default": false,
          "description": "%kablix.config.showClearDiagramButton%"
        },
        "kablix.foldLibraryOnRun": {
          "type": "boolean",
          "default": true,
          "description": "%kablix.config.foldLibraryOnRun%"
        },
        "kablix.picowNetworkBridge": {
          "type": "boolean",
          "default": true,
          "description": "%kablix.config.picowNetworkBridge%"
        },
        "kablix.selectionColor": {
          "type": "string",
          "default": "#e973e9",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "%kablix.config.selectionColor%"
        },
        "kablix.svgEditorPath": {
          "type": "string",
          "default": "",
          "description": "%kablix.config.svgEditorPath%"
        },
        "kablix.syncArduinoIdeBoard": {
          "type": "boolean",
          "default": true,
          "description": "%kablix.config.syncArduinoIdeBoard%"
        },
        "kablix.syncIntelliSense": {
          "type": "boolean",
          "default": true,
          "description": "%kablix.config.syncIntelliSense%"
        },
        "kablix.componentsFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "%kablix.config.componentsFolder%"
        },
        "kablix.componentRepositories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "https://raw.githubusercontent.com/FrankSAURET/kablix/main/kablix_components/"
          ],
          "description": "%kablix.config.componentRepositories%"
        }
      }
    }
  },
  "scripts": {
