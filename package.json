run verify:layout && npm run verify:clipboard && npm run verify:ultrasonic && npm run verify:savename && npm run verify:deleted-file && npm run verify:uiconfig && npm run verify:open-blank && npm run verify:vierge && npm run verify:button-latch && npm run verify:pir && npm run verify:npchain && npm run verify:picow-led && npm run verify:pin-readback && npm run verify:boardleds && npm run verify:dht22 && npm run verify:dht-e2e && npm run verify:ds18b20 && npm run verify:ds18b20-moteur && npm run verify:ds18b20-e2e && npm run verify:ds18b20-uno-e2e && npm run verify:serial && npm run verify:realtime && npm run verify:keypadsim && npm run verify:sdcard && npm run verify:sdcard-e2e && npm run verify:reveal && npm run verify:worker && npm run verify:simspeed && npm run verify:joystick && npm run verify:netcache && npm run verify:capacitor && npm run verify:condo-e2e && npm run verify:resistance && npm run verify:flip && npm run verify:fan && npm run verify:motor && npm run verify:transistor && npm run verify:ascenseur && npm run verify:ic && npm run verify:creator-ui && npm run verify:refnames && npm run verify:bom && npm run verify:pot && npm run verify:autopan && npm run verify:wirecolor && npm run verify:i18n && npm run verify:tags && npm run verify:help-bars && npm run verify:guide-nav && npm run verify:hygiene && npm run verify:profils && npm run verify:assemblage && npm run verify:dmx && npm run verify:shield && npm run verify:picoupload && npm run verify:pico2 && npm run verify:arduinoide && npm run verify:arduinocli && npm run verify:intellisense && npm run verify:rfid && npm run verify:rfid:e2e && npm run verify:reouverture",
